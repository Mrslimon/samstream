# Copy to .env.local (gitignored) and fill in. Values are baked into dist/ at build time.

# Streams the milestone 2 spike cycles through (left/right or 1-9 on the remote).
VITE_SPIKE_STREAMS='[{"label":"RTSP main","url":"rtsp://user:pass@192.168.1.6:554/Streaming/channels/101"},{"label":"RTSP sub","url":"rtsp://user:pass@192.168.1.6:554/Streaming/channels/102"},{"label":"HLS go2rtc","url":"http://192.168.1.5:1984/api/stream.m3u8?src=door"}]'

# Used by `npm run tv:*` (scripts/tizen.mjs)
TV_HOST=192.168.1.x
TIZEN_PROFILE=samstream
TIZEN_HOME=C:\tizen-studio
