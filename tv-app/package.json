{
  "name": "samstream-tv-app",
  "private": true,
  "version": "0.9.1",
  "description": "Samstream Tizen TV player (AVPlay RTSP/HLS with Arabic-ready overlay)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc",
    "test": "vitest run",
    "tv:package": "node --env-file-if-exists=.env.local scripts/tizen.mjs package",
    "tv:install": "node --env-file-if-exists=.env.local scripts/tizen.mjs install",
    "tv:run": "node --env-file-if-exists=.env.local scripts/tizen.mjs run",
    "tv:deploy": "npm run build && node --env-file-if-exists=.env.local scripts/tizen.mjs deploy",
    "tv:notifier": "node --env-file-if-exists=.env.local scripts/tizen.mjs notifier",
    "tv:notifier-install": "node --env-file-if-exists=.env.local scripts/tizen.mjs notifier-install"
  },
  "dependencies": {
    "@fontsource/readex-pro": "^5.3.0",
    "lottie-web": "5.12.2"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^8.2.3",
    "happy-dom": "^21.0.3",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
